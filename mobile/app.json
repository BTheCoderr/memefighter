{
  "expo": {
    "name": "Meme Fighter",
    "slug": "meme-fighter",
    "owner": "bferrell514",
    "version": "0.1.0",
    "scheme": "memefighter",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.bthedream.memefighter",
      "supportsTablet": false,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.bthedream.memefighter"
    },
    "extra": {},
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ]
    ]
  }
}
