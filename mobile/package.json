{
  "name": "meme-fighter-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "sync:game": "node scripts/sync-game.mjs",
    "check:game": "node scripts/sync-game.mjs --check",
    "test:rooms": "node --experimental-strip-types --test tests/rooms.test.ts",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios",
    "preflight:ios": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "expo": "~54.0.37",
    "expo-haptics": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
